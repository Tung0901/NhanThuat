{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nhan-thuat.local/schemas/knowledge-unit.schema.json",
  "title": "Nhân Thuật Knowledge Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "version", "title", "summary", "primary_domain", "definition", "conditions", "exceptions", "applications", "risks", "evidence", "relations", "tags", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^NT-(LAW|PRINCIPLE|MODEL|STRATEGY|TOOL|CASE|EVIDENCE|ANTI-PATTERN)-[0-9]{4}$"},
    "type": {"enum": ["law", "principle", "model", "strategy", "tool", "case", "evidence", "anti-pattern"]},
    "status": {"enum": ["idea", "draft", "review", "approved", "frozen", "deprecated"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 20},
    "primary_domain": {"$ref": "#/$defs/domainSlug"},
    "secondary_domains": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/domainSlug"}},
    "definition": {"type": "string", "minLength": 20},
    "mechanism": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "exceptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "applications": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["level", "references"],
      "properties": {
        "level": {"enum": ["hypothesis", "provisional", "supported", "strong", "contested"]},
        "references": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "relations": {
      "type": "object", "additionalProperties": false,
      "required": ["supports", "conflicts_with", "depends_on", "applies_to"],
      "properties": {
        "supports": {"$ref": "#/$defs/idList"}, "conflicts_with": {"$ref": "#/$defs/idList"},
        "depends_on": {"$ref": "#/$defs/idList"}, "applies_to": {"$ref": "#/$defs/idList"}
      }
    },
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "domainSlug": {"type": "string", "enum": ["tu-than", "tri-nhan", "dung-nhan", "hop-chung", "thanh-su"]},
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^NT-[A-Z]+(?:-[A-Z]+)*-[0-9]{4}$"}}
  }
}

