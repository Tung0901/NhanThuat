{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nhan-thuat.local/schemas/domain.schema.json",
  "title": "Nhân Thuật Domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "type", "status", "version", "name", "description", "topics"],
  "properties": {
    "id": {"type": "string", "pattern": "^NT-D0[1-5]$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type": {"const": "domain"},
    "status": {"enum": ["idea", "draft", "review", "approved", "frozen", "deprecated"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 20},
    "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"}
  }
}

