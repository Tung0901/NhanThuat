# ==========================================
# CẤU HÌNH API KEY (LLM & TRÍ TUỆ NHÂN TẠO)
# ==========================================
# Yêu cầu cấu hình 1 key duy nhất để truy cập Google Gemini 3.6 Flash
GOOGLE_API_KEY=your_google_api_key_here

# TypeSafe AI Jev System One Decision API (tùy chọn; tự động dùng mock nếu chưa cấu hình)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ==========================================
# CẤU HÌNH BẢO MẬT & XÁC THỰC EXECUTIVE STUDIO
# ==========================================
# Mật khẩu bắt buộc. Không dùng mật khẩu mẫu trong môi trường triển khai.
NT_ADMIN_PASSWORD=replace-with-a-long-unique-password
NT_EXECUTIVE_PASSWORD=replace-with-a-long-unique-password
NT_ADVISOR_PASSWORD=replace-with-a-long-unique-password
NT_GUEST_PASSWORD=replace-with-a-long-unique-password
NT_SESSION_TTL_SECONDS=86400
