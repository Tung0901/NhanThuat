# .streamlit/secrets.toml.example
#
# Cấu hình LLM synthesis cho trang "Hỏi Nhân Thuật".
# Nhân Thuật sử dụng Google AI Studio (Gemini) làm nhà cung cấp duy nhất.

# --- Google Gemini (bắt buộc để bật LLM) ---
# 1. Tạo API key miễn phí tại https://aistudio.google.com/apikey
# 2. Dán key vào GEMINI_API_KEY. Base URL và mô hình mặc định đã được
#    thiết lập sẵn; chỉ cần thêm khi muốn tùy chỉnh.
GEMINI_API_KEY = "AIzaSy...key-của-bạn"
# GEMINI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
# GEMINI_MODEL = "gemini-2.5-flash"

# --- Trên Streamlit Community Cloud ---
# Không dùng file này; vào app → Settings → Secrets và dán nguyên khối TOML
# tương ứng (không cần đánh dấu #) vào ô Secrets, ví dụ:
#
# GEMINI_API_KEY = "AIzaSy..."

[auth]
# Add any authentication config if needed later