# .streamlit/secrets.toml.example
#
# Cấu hình LLM synthesis cho trang "Hỏi Nhân Thuật".
# Chọn MỘT trong hai nhà cung cấp OpenAI-compatible dưới đây.

# --- Google Gemini (khuyến nghị) ---
# 1. Tạo API key miễn phí tại https://aistudio.google.com/apikey
# 2. Dán key vào OPENAI_API_KEY và dùng base URL OpenAI-compatible của Gemini:
OPENAI_API_KEY = "AIzaSy...key-của-bạn"
OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
NHAN_THUAT_LLM_MODEL = "gemini-2.5-flash"

# --- Hoặc OpenAI / provider OpenAI-compatible khác ---
# OPENAI_API_KEY = "sk-..."
# OPENAI_BASE_URL = "https://api.openai.com/v1"
# NHAN_THUAT_LLM_MODEL = "gpt-4o-mini"

# --- Trên Streamlit Community Cloud ---
# Không dùng file này; vào app → Settings → Secrets và dán nguyên khối TOML
# tương ứng (không cần đánh dấu #) vào ô Secrets, ví dụ:
#
# OPENAI_API_KEY = "AIzaSy..."
# OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
# NHAN_THUAT_LLM_MODEL = "gemini-2.5-flash"

[auth]
# Add any authentication config if needed later